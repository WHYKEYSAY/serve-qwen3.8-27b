diff --git a/src/media/decode/decode.cpp b/src/media/decode/decode.cpp
index fb60d30..3a5c8fd 100644
--- a/src/media/decode/decode.cpp
+++ b/src/media/decode/decode.cpp
@@ -395,6 +395,7 @@ int rotation_of(const AVStream* stream) {
     if (tag != nullptr) {
         rotation = static_cast<int>(std::nearbyint(std::strtod(tag->value, nullptr)));
     }
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(60, 31, 102)
     const AVPacketSideData* side =
         av_packet_side_data_get(stream->codecpar->coded_side_data,
                                 stream->codecpar->nb_coded_side_data, AV_PKT_DATA_DISPLAYMATRIX);
@@ -402,6 +403,16 @@ int rotation_of(const AVStream* stream) {
         rotation = static_cast<int>(std::nearbyint(
             -av_display_rotation_get(reinterpret_cast<const std::int32_t*>(side->data))));
     }
+#else
+    // Isolated Debian12 build: older FFmpeg keeps this metadata on AVStream.
+    std::size_t side_size = 0;
+    const std::uint8_t* side_data =
+        av_stream_get_side_data(stream, AV_PKT_DATA_DISPLAYMATRIX, &side_size);
+    if (side_data != nullptr && side_size >= 9 * sizeof(std::int32_t)) {
+        rotation = static_cast<int>(std::nearbyint(
+            -av_display_rotation_get(reinterpret_cast<const std::int32_t*>(side_data))));
+    }
+#endif
     rotation %= 360;
     if (rotation < 0) { rotation += 360; }
     if (rotation == 89 || rotation == 91) { rotation = 90; }
