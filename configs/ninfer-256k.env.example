# Example only: copy to a private .env, customize, and source explicitly.
# Never put credentials here. These are local KECHENGY paths, not bundled files.
export NINFER_BINARY=/mnt/d/AI/bench/inse691-256k-loop/ninfer-bin/ninfer-serve
export NINFER_MODEL=/mnt/d/models/qwen3.8-27b/ninfer-nvfp4-a107ba1b/qwen3_8_27b_nvfp4.ninfer
export NINFER_CUDA_DIR=/mnt/d/AI/bench/sglang-0519/lib/python3.11/site-packages/nvidia/cu13
export NINFER_RUNTIME_LIB_DIR=/mnt/d/AI/bench/inse691-256k-loop/ninfer-sysroot/usr/lib/x86_64-linux-gnu
# Share the existing test lock when launching from another checkout on this node.
export NINFER_LOCK_FILE=/mnt/d/AI/bench/inse691-256k-loop/.gpu-test.lock
# Optional: set NINFER_GPU to a GPU UUID from nvidia-smi.
# If omitted, the launcher requires exactly one detected RTX5090.
